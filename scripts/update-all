#!/usr/bin/env bash
# shellcheck disable=SC1091

# Author: Josiah Bull <josiah.bull7@gmail.com>
# License: MIT/Apache-2.0

# Wrapper script to update all installed packages on a system, wherever possible

set -o errexit -o pipefail -o noclobber -o nounset

current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$current_dir"/functions.sh
source "$current_dir"/lib/release-apps.sh

set_log "update-all"

is_macos=false
if [ "$(uname -s)" = Darwin ]; then
  is_macos=true
fi

# Update System
# macOS
if [ "$is_macos" = true ]; then
  if ! command -v brew &> /dev/null; then
    exit_error "Homebrew not found"
  fi
  run_cmd_wrap brew update
  run_cmd_wrap brew upgrade
  run_cmd_wrap brew cleanup
# Ubuntu
elif [ -f /etc/lsb-release ]; then
  cmd=("sudo" "apt-get" "update")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "apt-get" "upgrade" "-y")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "apt-get" "dist-upgrade" "-y")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "apt-get" "autoremove" "-y")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "apt-get" "autoclean")
  run_cmd_wrap "${cmd[@]}"
# Fedora, Rocky and other dnf-based distributions
elif [ -f /etc/fedora-release ] || [ -f /etc/rocky-release ] || command -v dnf &> /dev/null; then
  # --refresh replaces dnf check-update, which exits 100 when updates exist.
  cmd=("sudo" "dnf" "upgrade" "--refresh" "-y")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "dnf" "autoremove" "-y")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "dnf" "clean" "all")
  run_cmd_wrap "${cmd[@]}"
else
  exit_error "Unsupported distribution"
fi

# Update installed personal applications from their latest GitHub releases.
update_personal_apps

# Update Mac App Store apps
if [ "$is_macos" = true ] && command -v mas &> /dev/null; then
  run_cmd_wrap mas upgrade
fi

# macOS updates need a restart, so list them rather than installing
if [ "$is_macos" = true ]; then
  debug_cmd "softwareupdate --list"
  softwareupdate --list || warn "softwareupdate --list failed"
# Update device firmware
elif [ -f /usr/bin/fwupdmgr ]; then
  cmd=("sudo" "fwupdmgr" "refresh" "--force")
  run_cmd_wrap "${cmd[@]}"
  cmd=("sudo" "fwupdmgr" "update" "--no-reboot-check" "--assume-yes")
  run_cmd_wrap "${cmd[@]}"
else
  warn "fwupdmgr not found, skipping firmware update"
fi

# Update Snaps
if which snap &> /dev/null; then
  cmd=("sudo" "snap" "refresh")
  run_cmd_wrap "${cmd[@]}"
fi

# Update Flatpaks
if which flatpak &> /dev/null; then
  cmd=("sudo" "flatpak" "update")
  run_cmd_wrap "${cmd[@]}"
fi

# Update Pip if not externally managed, by checking if /usr/lib/python3.12/EXTERNALLY-MANAGED exists
externally_managed_exists=1
if [ "$is_macos" = false ]; then
  externally_managed_exists=$(find /usr/lib/ -type f -name "EXTERNALLY-MANAGED" | wc -l)
fi
if [ "$externally_managed_exists" -eq 0 ]; then
  cmd=("pip" "install" "--upgrade" "pip")
  run_cmd_wrap "${cmd[@]}"
else
  debug "Pip is externally managed, skipping update"
fi

# Update Rust
if which rustup &> /dev/null; then
  cmd=("rustup" "update")
  run_cmd_wrap "${cmd[@]}"
  if command -v cargo-install-update &> /dev/null; then
    cmd=("cargo" "install-update" "-a")
    run_cmd_wrap "${cmd[@]}"
  fi
fi

# Update NPM Packages
if which npm &> /dev/null; then
  cmd=("npm" "install" "-g" "npm@latest")
  run_cmd_wrap "${cmd[@]}"

  cmd=("npm" "update" "-g")
  run_cmd_wrap "${cmd[@]}"
fi

# Update Gcloud. Linux package-manager installs disable the component manager,
# so only update the user install there; the Homebrew cask allows it.
gcloud_bin=""
if [ -x "$HOME/.google-cloud-sdk/bin/gcloud" ]; then
  gcloud_bin="$HOME/.google-cloud-sdk/bin/gcloud"
elif [ "$is_macos" = true ] && command -v gcloud &> /dev/null; then
  gcloud_bin="$(command -v gcloud)"
fi
if [ -n "$gcloud_bin" ]; then
  run_cmd_wrap "$gcloud_bin" components update --quiet
fi

exit_success
